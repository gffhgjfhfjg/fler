# ── Gradle ──
.gradle/
build/
/app/build/
*.iml
.kotlin/

# ── Local / IDE ──
/local.properties
local.properties
.idea/
captures/
.externalNativeBuild
.cxx

# ── OS ──
.DS_Store
Thumbs.db

# ── fler 运行/下载产物（不入库）──
fler-engines/
# 打包脚本产物（scripts/package-native-libs.ps1 输出的 tar.xz/sha256/manifest 等）
/out/
*.7z
*.zip
*.log
*.bak

# ── keystone 静态库（GitHub Actions 交叉编译产物，构建期 fetchKeystone 下载）──
/app/libs/

# ── unicorn 源码与构建产物（scripts/build-unicorn.ps1 交叉编译）──
/vendor/

# ── 开发/调研/工具目录或文档（不入库）──
# 根目录除 README.md 外的其他 md（开发测试、调研、方案计划）全部忽略
/*.md
!/README.md
# .qoder / .trae（本地调研/Agent 工具目录）
.qoder/
.trae/
# docs 目录只保留 .md（skill/提示词），忽略其余（如 lorebook json）
/docs/**
!/docs/
!/docs/**/
!/docs/**/*.md
